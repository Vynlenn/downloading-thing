<Window x:Class="DeezNutzDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeezNutz Downloader"
        Width="1220"
        Height="790"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="22,24,18,22">
                    <TextBlock Text="DeezNutz"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Downloader"
                               FontSize="15"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <Button Grid.Row="1"
                        Margin="14,0,14,16"
                        Content="+ Add links"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddLinks_Click" />

                <StackPanel Grid.Row="2">
                    <Button x:Name="DownloadsNavigationButton"
                            Tag="Downloads"
                            Content="↓  Downloads"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click" />

                    <Button x:Name="LinkGrabberNavigationButton"
                            Tag="LinkGrabber"
                            Content="⌕  Link Grabber"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click" />

                    <Button x:Name="SettingsNavigationButton"
                            Tag="Settings"
                            Content="⚙  Settings"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click" />
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="14"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceSecondaryBrush}">
                    <StackPanel>
                        <TextBlock Text="Network"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="NetworkSummaryText"
                                   Margin="0,3,0,0"
                                   Text="Windows settings"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="34,24"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock x:Name="PageTitleText"
                               Text="Downloads"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitleText"
                               Margin="0,4,0,0"
                               Text="Manage active, queued, and completed downloads."
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="34,28">
                <Grid x:Name="DownloadsPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Download queue"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <TextBlock x:Name="DownloadQueueCountText"
                                       Margin="0,0,18,0"
                                       Text="0 items"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <Button x:Name="ClearDownloadQueueButton"
                                    Content="Clear queue"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ClearDownloadQueue_Click" />

                            <Button x:Name="ClearFinishedDownloadsButton"
                                    Content="Clear finished"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ClearFinishedDownloads_Click" />

                            <Button x:Name="StartAllDownloadsButton"
                                    Content="Start all"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="StartAllDownloads_Click" />

                            <Button x:Name="CancelAllDownloadsButton"
                                    Content="Cancel all"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CancelAllDownloads_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,18,0,0"
                            Padding="20"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <StackPanel x:Name="DownloadQueueEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="500"
                                        Margin="30">
                                <TextBlock Text="No downloads yet"
                                           HorizontalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold" />

                                <TextBlock Margin="0,8,0,18"
                                           Text="Analyze links, add the valid results to this queue, then start the batch when you are ready."
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <Button Content="Open Link Grabber"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddLinks_Click" />
                            </StackPanel>

                            <Grid x:Name="DownloadQueueContent"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Downloads use the saved destination and network settings. Failed or canceled items can be started again."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <ScrollViewer Grid.Row="1"
                                              Margin="0,14,0,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="DownloadQueueList">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Stretch" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,9"
                                                        Padding="14"
                                                        CornerRadius="9"
                                                        Background="{DynamicResource SurfaceSecondaryBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding EffectiveDisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="15"
                                                                       TextWrapping="Wrap" />

                                                            <TextBlock Margin="0,2,0,0"
                                                                       Text="{Binding PackageName, StringFormat='Package · {0}'}"
                                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PackageName}"
                                                                                         Value="{x:Null}">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PackageName}"
                                                                                         Value="">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Margin="0,5,0,0"
                                                                       Text="{Binding Url}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       TextWrapping="Wrap" />

                                                            <ProgressBar Margin="0,11,0,0"
                                                                         Height="7"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Value="{Binding ProgressPercentage}"
                                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                                         Foreground="{DynamicResource AccentBrush}"
                                                                         Background="{DynamicResource AppBackgroundBrush}"
                                                                         BorderThickness="0" />

                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{Binding ProgressText}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       TextWrapping="Wrap" />

                                                            <TextBlock Margin="0,5,0,0"
                                                                       Text="{Binding ErrorMessage}"
                                                                       TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource ErrorBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ErrorMessage}"
                                                                                         Value="{x:Null}">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ErrorMessage}"
                                                                                         Value="">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    Margin="18,0,0,0"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Border Margin="0,0,10,0"
                                                                    Padding="10,5"
                                                                    CornerRadius="8"
                                                                    Background="{DynamicResource AccentSoftBrush}">
                                                                <TextBlock Text="{Binding Status}"
                                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <Button Content="Retry"
                                                                    Tag="{Binding Id}"
                                                                    IsEnabled="{Binding CanRetry}"
                                                                    Margin="0,0,8,0"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Click="RetryQueuedItem_Click" />

                                                            <Button Content="Remove"
                                                                    Tag="{Binding Id}"
                                                                    IsEnabled="{Binding CanRemove}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Click="RemoveQueuedItem_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="LinkGrabberPage"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Paste links"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <Border Grid.Row="1"
                            Margin="0,14,0,18"
                            Padding="18"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Enter one address per line. Links are validated locally; no network requests are made."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <TextBox x:Name="LinksTextBox"
                                     Grid.Row="1"
                                     Margin="0,12,0,12"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     TextChanged="LinksTextBox_TextChanged" />

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Clear"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ClearLinks_Click" />
                                <Button Content="Analyze links"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="AnalyzeLinks_Click" />

                                <Button x:Name="GrabVideoButton"
                                        Content="Grab video"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Probe one video page with yt-dlp and download the best quality."
                                        Click="GrabVideo_Click" />

                                <Button x:Name="CrawlPageButton"
                                        Content="Crawl page"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Fetch one page and pull out its file-host links, skipping avatars, logos, and navigation."
                                        Click="CrawlPage_Click" />

                                <Button x:Name="QueueValidLinksButton"
                                        Content="Add valid to queue"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="QueueValidLinks_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="20"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Analysis results"
                                           FontSize="18"
                                           FontWeight="SemiBold" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <TextBlock x:Name="ValidLinksCountText"
                                               Text="Valid  0"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontWeight="SemiBold" />

                                    <TextBlock x:Name="DuplicateLinksCountText"
                                               Margin="18,0,0,0"
                                               Text="Duplicates  0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontWeight="SemiBold" />

                                    <TextBlock x:Name="InvalidLinksCountText"
                                               Margin="18,0,0,0"
                                               Text="Invalid  0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,6,0,14">
                                <TextBlock x:Name="LinkGrabberStatusText"
                                           Text="Paste links above to analyze them locally."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="PackageSummaryText"
                                           Margin="0,4,0,0"
                                           Text=""
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AnalysisResultsList">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment"
                                                    Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="12"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Top" />

                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,16,0">
                                                        <TextBlock Text="{Binding OriginalText}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />

                                                        <TextBlock Margin="0,4,0,0"
                                                                   Text="{Binding Detail}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding LineLabel}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760"
                                HorizontalAlignment="Left">
                        <TextBlock Text="General"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Default download folder"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,8"
                                           Text="New downloads will use this folder unless a package overrides it."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="DownloadFolderTextBox" />

                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Use default"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="UseDefaultFolder_Click" />
                                </Grid>

                                <TextBlock Margin="0,18,0,6"
                                           Text="Concurrent downloads"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,0,0,6"
                                           Text="How many files download at once (1 to 64). Applies to the next batch."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBox x:Name="ConcurrencyTextBox"
                                         Width="120"
                                         HorizontalAlignment="Left" />

                                <CheckBox x:Name="OrganizeFoldersCheckBox"
                                          Margin="0,14,0,0"
                                          Content="Organize downloads into site subfolders" />

                                <CheckBox x:Name="ClipboardWatchCheckBox"
                                          Margin="0,8,0,0"
                                          Content="Watch clipboard for new links" />

                                <TextBlock Margin="0,18,0,6"
                                           Text="Theme"
                                           FontWeight="SemiBold" />
                                <ComboBox x:Name="ThemeComboBox"
                                          Width="220"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Follow Windows"
                                                  Tag="System" />
                                    <ComboBoxItem Content="Light"
                                                  Tag="Light" />
                                    <ComboBoxItem Content="Dark"
                                                  Tag="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Network"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Connection mode"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,8"
                                           Text="Windows settings is the recommended default. Saved connection settings are applied at the start of each new download batch."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <ComboBox x:Name="NetworkModeComboBox"
                                          Width="280"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="NetworkModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Use Windows internet settings"
                                                  Tag="WindowsSettings" />
                                    <ComboBoxItem Content="Direct connection"
                                                  Tag="Direct" />
                                    <ComboBoxItem Content="Manual proxy"
                                                  Tag="ManualProxy" />
                                </ComboBox>

                                <Grid x:Name="ManualProxyPanel"
                                      Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               VerticalAlignment="Center"
                                               Text="Proxy type" />
                                    <ComboBox x:Name="ProxyTypeComboBox"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              Width="180"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="ProxyTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="HTTP"
                                                      Tag="Http" />
                                        <ComboBoxItem Content="HTTPS"
                                                      Tag="Https" />
                                        <ComboBoxItem Content="SOCKS4"
                                                      Tag="Socks4" />
                                        <ComboBoxItem Content="SOCKS5"
                                                      Tag="Socks5" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,12,0,0"
                                               VerticalAlignment="Center"
                                               Text="Server" />
                                    <TextBox x:Name="ProxyHostTextBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="0,12,0,0" />

                                    <TextBlock Grid.Row="2"
                                               Margin="0,12,0,0"
                                               VerticalAlignment="Center"
                                               Text="Port" />
                                    <TextBox x:Name="ProxyPortTextBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             Width="120"
                                             Margin="0,12,0,0"
                                             HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="3"
                                               Margin="0,12,0,0"
                                               VerticalAlignment="Center"
                                               Text="Username" />
                                    <TextBox x:Name="ProxyUsernameTextBox"
                                             Grid.Row="3"
                                             Grid.Column="1"
                                             Margin="0,12,0,0"
                                             ToolTip="Leave empty when the proxy needs no login." />

                                    <TextBlock Grid.Row="4"
                                               Margin="0,12,0,0"
                                               VerticalAlignment="Center"
                                               Text="Password" />
                                    <PasswordBox x:Name="ProxyPasswordBox"
                                                 Grid.Row="4"
                                                 Grid.Column="1"
                                                 Margin="0,12,0,0"
                                                 ToolTip="Stored encrypted (Windows DPAPI). Leave empty to keep the saved one." />

                                    <TextBlock x:Name="ProxySocksWarningText"
                                               Grid.Row="5"
                                               Grid.ColumnSpan="2"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Text="SOCKS proxies are not supported in this version. Choose HTTP or HTTPS." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Media tools (yt-dlp)"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Video grabs use the yt-dlp and FFmpeg programs. Automatic mode downloads official builds into the app data folder and keeps them working. Manual paths always win; leave a field empty to use the program found on PATH."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="AutoToolsCheckBox"
                                          Margin="0,12,0,0"
                                          Content="Download and maintain yt-dlp / FFmpeg automatically" />
                                <TextBlock Margin="0,12,0,6"
                                           Text="yt-dlp path (optional)"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="YtDlpPathTextBox" />
                                <TextBlock Margin="0,12,0,6"
                                           Text="FFmpeg path (optional)"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="FFmpegPathTextBox" />
                                <TextBlock Margin="0,12,0,6"
                                           Text="Browser cookies for yt-dlp (optional)"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="YtDlpCookiesTextBox"
                                         ToolTip="e.g. chrome, firefox, edge, or brave:profile-name. Uses your own logged-in session for video sites that need a login. Leave empty to turn off." />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Optional: e.g. chrome or firefox. Reads cookies from your own browser so yt-dlp can reach videos your account can see." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Storage mode"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="StorageModeText"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DataFolderText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Download history"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="HistoryStatusText"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="No finished downloads remembered yet." />
                                <Button x:Name="ClearHistoryButton"
                                        Content="Forget download history"
                                        Margin="0,12,0,0"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        Click="ClearHistory_Click" />
                            </StackPanel>
                        </Border>

                        <Button Content="Save settings"
                                Width="150"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveSettings_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Padding="34,12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="ApplicationStatusText"
                           Text="Ready  •  Dark Jade  •  No network activity"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
