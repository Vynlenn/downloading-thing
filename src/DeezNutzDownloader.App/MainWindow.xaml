<Window x:Class="DeezNutzDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeezNutz Downloader"
        Width="1220"
        Height="790"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="22,24,18,22">
                    <TextBlock Text="DeezNutz"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Downloader"
                               FontSize="15"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <Button Grid.Row="1"
                        Margin="14,0,14,16"
                        Content="+ Add links"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddLinks_Click" />

                <StackPanel Grid.Row="2">
                    <Button x:Name="DownloadsNavigationButton"
                            Tag="Downloads"
                            Content="↓  Downloads"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click" />

                    <Button x:Name="LinkGrabberNavigationButton"
                            Tag="LinkGrabber"
                            Content="⌕  Link Grabber"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click" />

                    <Button x:Name="SettingsNavigationButton"
                            Tag="Settings"
                            Content="⚙  Settings"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click" />
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="14"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceSecondaryBrush}">
                    <StackPanel>
                        <TextBlock Text="Network"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="NetworkSummaryText"
                                   Margin="0,3,0,0"
                                   Text="Windows settings"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="34,24"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock x:Name="PageTitleText"
                               Text="Downloads"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitleText"
                               Margin="0,4,0,0"
                               Text="Manage active, queued, and completed downloads."
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="34,28">
                <Grid x:Name="DownloadsPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Download queue"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Content="Start all"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="Pause all"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,18,0,0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="500"
                                    Margin="30">
                            <TextBlock Text="No downloads yet"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,18"
                                       Text="Add one or more links to begin. The actual download engine will be added in a later checkpoint."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Button Content="Open Link Grabber"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AddLinks_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="LinkGrabberPage"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Paste links"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <Border Grid.Row="1"
                            Margin="0,14,0,18"
                            Padding="18"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Enter one address per line. Nothing is sent over the network at this checkpoint."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <TextBox x:Name="LinksTextBox"
                                     Grid.Row="1"
                                     Margin="0,12,0,12"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" />

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Clear"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ClearLinks_Click" />
                                <Button Content="Analyze links"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AnalyzeLinks_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="24"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="No analyzed links"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="LinkGrabberStatusText"
                                       Margin="0,7,0,0"
                                       Text="The link-analysis engine has not been connected yet."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760"
                                HorizontalAlignment="Left">
                        <TextBlock Text="General"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Default download folder"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,8"
                                           Text="New downloads will use this folder unless a package overrides it."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="DownloadFolderTextBox" />

                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Use default"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="UseDefaultFolder_Click" />
                                </Grid>

                                <TextBlock Margin="0,18,0,6"
                                           Text="Theme"
                                           FontWeight="SemiBold" />
                                <ComboBox x:Name="ThemeComboBox"
                                          Width="220"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Follow Windows"
                                                  Tag="System" />
                                    <ComboBoxItem Content="Light"
                                                  Tag="Light" />
                                    <ComboBoxItem Content="Dark"
                                                  Tag="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Network"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Connection mode"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,8"
                                           Text="Windows settings is the recommended default. Manual proxy information is saved now but will not be used until the download engine is connected."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <ComboBox x:Name="NetworkModeComboBox"
                                          Width="280"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="NetworkModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Use Windows internet settings"
                                                  Tag="WindowsSettings" />
                                    <ComboBoxItem Content="Direct connection"
                                                  Tag="Direct" />
                                    <ComboBoxItem Content="Manual proxy"
                                                  Tag="ManualProxy" />
                                </ComboBox>

                                <Grid x:Name="ManualProxyPanel"
                                      Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               VerticalAlignment="Center"
                                               Text="Proxy type" />
                                    <ComboBox x:Name="ProxyTypeComboBox"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              Width="180"
                                              HorizontalAlignment="Left">
                                        <ComboBoxItem Content="HTTP"
                                                      Tag="Http" />
                                        <ComboBoxItem Content="HTTPS"
                                                      Tag="Https" />
                                        <ComboBoxItem Content="SOCKS4"
                                                      Tag="Socks4" />
                                        <ComboBoxItem Content="SOCKS5"
                                                      Tag="Socks5" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,12,0,0"
                                               VerticalAlignment="Center"
                                               Text="Server" />
                                    <TextBox x:Name="ProxyHostTextBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="0,12,0,0" />

                                    <TextBlock Grid.Row="2"
                                               Margin="0,12,0,0"
                                               VerticalAlignment="Center"
                                               Text="Port" />
                                    <TextBox x:Name="ProxyPortTextBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             Width="120"
                                             Margin="0,12,0,0"
                                             HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Storage mode"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <Border Margin="0,14,0,24"
                                Padding="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="StorageModeText"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DataFolderText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button Content="Save settings"
                                Width="150"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveSettings_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Padding="34,12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="ApplicationStatusText"
                           Text="Ready  •  Dark Jade  •  No network activity"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
