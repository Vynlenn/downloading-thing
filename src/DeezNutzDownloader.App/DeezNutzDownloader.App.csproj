<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeezNutzDownloader.Core\DeezNutzDownloader.Core.csproj" />
    <ProjectReference Include="..\DeezNutzDownloader.Infrastructure\DeezNutzDownloader.Infrastructure.csproj" />
    <ProjectReference Include="..\DeezNutzDownloader.Adapters\DeezNutzDownloader.Adapters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the global usings so WPF names
         (Application, MessageBox, Button...) stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
