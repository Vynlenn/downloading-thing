<Window x:Class="DeezNutzDownloader.App.ChallengeSolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Solve challenge"
        Width="900"
        Height="650"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="InstructionText"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="Complete the check below, then choose Done." />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="This is the site's own page in a real browser. The app never sees your keystrokes — only the session cookies the site sets afterwards, stored encrypted on this PC." />
            </StackPanel>
        </Border>

        <wv2:WebView2 x:Name="Browser"
                      Grid.Row="1" />

        <Border Grid.Row="2"
                Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ForgetButton"
                        Content="Forget saved session"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="ForgetButton_Click" />
                <Button Content="Cancel"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        IsCancel="True" />
                <Button x:Name="DoneButton"
                        Content="Done — use this session"
                        Padding="12,6"
                        IsDefault="True"
                        Click="DoneButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
